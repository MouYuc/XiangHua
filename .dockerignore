# Git 和本地开发辅助目录
.git/
.github/
.code-review-graph/
.playwright-cli/
.superpowers/
.venv/
.webui/

# 本地运行数据；这些由 docker-compose.yml 挂载进容器
.guangpu_webui/
models/
my_voice/
output/
patches/

# 本地 GPT-SoVITS 源码/运行目录；镜像构建时会按锁定 commit 重新克隆
GPT-SoVITS/

# 前端依赖与本地构建产物；镜像内会重新执行 npm ci && npm run build
frontend/node_modules/
frontend/dist/

# 不参与镜像运行内容的本地文档与示例
docs/
examples/
preview/
tests/

# Python / Node 缓存
**/__pycache__/
*.py[cod]
*.mypy_cache/
*.pytest_cache/
*.ruff_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统与日志文件
.DS_Store
Thumbs.db
*.log
